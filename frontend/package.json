{
  "name": "vps-control-room-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "bun test src",
    "test:all": "bun run check && bun run test",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "verify": "bun run check && bun run lint && bun run test && bun run build && bun run test:e2e",
    "test:coverage": "bash ../scripts/check-bun-coverage.sh . 90 85",
    "check:bundle": "node scripts/check-bundle-budget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "bits-ui": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.0",
    "tailwind-merge": "^2.6.1",
    "tailwind-variants": "^0.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.400.0",
    "ws": "^8.21.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "overrides": {
    "cookie": "0.7.2"
  }
}
