# VPS Control Room — env example
# Copy to .env.local and edit. .env.local is gitignored.
# Generate strong secrets with: openssl rand -hex 32

# --- Auth ---
# [REQUIRED] login secret
CONTROL_ROOM_SECRET=replace_me
# [REQUIRED] DIFFERENT 32+ char secret that signs the session cookie
CONTROL_ROOM_SESSION_SECRET=replace_me_different_from_above
# [OPTIONAL] dedicated frontend -> agent bearer secret. If unset, the agent
# gateway falls back to CONTROL_ROOM_SECRET; setting a dedicated value is safer.
AGENT_GATEWAY_SECRET=
# [OPTIONAL] sliding session lifetime in hours
SESSION_EXPIRY_HOURS=72
# [OPTIONAL] stable approved-device JSON path; keep it outside disposable worktrees in production.
AUTH_DEVICE_STORE=

# --- Frontend: SvelteKit adapter-node on Bun ---
# [OPTIONAL] local/manual run settings. Production systemd binds 0.0.0.0:4000.
CONTROL_ROOM_PORT=4000
CONTROL_ROOM_HOST=127.0.0.1
# [REQUIRED in production] public hostname used by Traefik deploy templates.
CONTROL_ROOM_DOMAIN=<your-domain>
# [RECOMMENDED in production] canonical public origin used by SvelteKit.
ORIGIN=https://<your-domain>
# Terminal uploads can reach 25 MiB, so keep adapter-node above that ceiling.
BODY_SIZE_LIMIT=30M
# Graceful SIGTERM/SIGINT drain bound. Long-lived SSE is force-closed after this.
SHUTDOWN_TIMEOUT=5

# --- Agent: Node 22 + node-pty ---
AGENT_HEALTH_PORT=4001
# Keep the privileged agent API on loopback unless you intentionally deploy it
# cross-host behind separate authentication.
AGENT_HEALTH_HOST=127.0.0.1
HOST_TELEMETRY_INTERVAL_MS=15000

# --- SI-Coder provider store (optional, auto-detected by default) ---
# Control Room discovers the SI-Coder package from ~/.local/bin/sc. Set this only
# when SI-Coder is installed elsewhere. Provider secrets remain in SI-Coder's
# own 0600 connection store and are never copied into Control Room state/env.
SI_CODER_ROOT=

# --- Docker collector ---
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Remote browser (optional) ---
# Pairs the control-room agent with an os-vps browser runtime.
OS_VPS_URL=https://<your-os-vps-host>
OS_AGENT_TOKEN=

# --- Terminal defaults (optional) ---
SHELL=/bin/bash
TERMINAL_DEFAULT_CWD=/home/<your-user>
