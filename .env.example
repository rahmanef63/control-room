# VPS Control Room — env example
#
# Copy this file to .env.local, then edit. .env.local is gitignored.
# Tags:
#   [REQUIRED]  must set before first login
#   [OPTIONAL]  default works for most setups
#   [PUBLIC]    ships to the browser — NEVER put secrets here
#
# Generate strong secrets with: openssl rand -hex 32

# --- Auth ---
# [REQUIRED] 32+ random hex chars — login secret
CONTROL_ROOM_SECRET=replace_me
# [REQUIRED] 32+ random hex chars — DIFFERENT from above, signs session cookie
CONTROL_ROOM_SESSION_SECRET=replace_me_different_from_above
# [OPTIONAL] dedicated machine secret the frontend uses to call the agent. If
# unset it falls back to CONTROL_ROOM_SECRET. Set it (any value, both processes
# read this same file) so the human login password isn't reused as the gateway
# bearer token.
AGENT_GATEWAY_SECRET=
# [OPTIONAL] session cookie lifetime in hours. Default 72 (3 days). Middleware
# slides this forward on activity, so an active dashboard never logs out; the cap
# only applies after this many hours of zero activity.
SESSION_EXPIRY_HOURS=72

# --- Frontend (server-only) ---
# [OPTIONAL] port the Next.js server binds
CONTROL_ROOM_PORT=4000
# [OPTIONAL] host the frontend binds — leave for systemd to pick up
CONTROL_ROOM_HOST=<your-tailscale-ip>
# [OPTIONAL] SvelteKit adapter-node request-body cap after migration cutover.
# Keep this above the agent's 25 MiB terminal-upload limit; adapter-node's
# default body limit is too small for this feature. Ignored by the current Next app.
BODY_SIZE_LIMIT=30M

# --- Agent (server-only) ---
# [OPTIONAL] health + state + log API port
AGENT_HEALTH_PORT=4001
# [OPTIONAL] interface the agent binds. Defaults to 127.0.0.1 (loopback) so the
# privileged host-control API is NOT exposed on the network. Only set 0.0.0.0
# for a real cross-host deployment, and front it with proper authn.
AGENT_HEALTH_HOST=127.0.0.1
HOST_TELEMETRY_INTERVAL_MS=15000

# --- Docker collector ---
# [OPTIONAL] path to docker socket. Skip the collector by leaving Docker uninstalled.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Remote browser (drive os-vps's headless Chromium) ---
# [OPTIONAL] base URL of the os-vps web OS that owns the browser runtime.
OS_VPS_URL=https://<your-os-vps-host>
# [OPTIONAL] agent token os-vps expects in `x-os-agent-token` (set the SAME value
# as OS_AGENT_TOKEN in os-vps's .env.local; >=16 chars). The agent drives the
# browser ONLY through os-vps's authed + audited routes — it never holds
# OS_BROWSER_SECRET or the runtime port. Browser tools are inert unless set.
OS_AGENT_TOKEN=

# --- Public env (ships to browser) ---
# [REQUIRED][PUBLIC] full https URL of your dashboard
NEXT_PUBLIC_APP_URL=https://<your-domain>
# [REQUIRED][PUBLIC] hostname only — used for cookie scope
NEXT_PUBLIC_APP_HOST=<your-domain>
